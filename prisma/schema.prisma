generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

model User {
  id              Int       @id  @default(autoincrement())
  fullName        String
  email           String    @unique
  passwordHash    String
  role            Role    @default(USER)
  quotes          Quote[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Quote {
  id                      Int       @id   @default(autoincrement())
  userId                  Int
  address                 String
  monthlyConsumptionKwh   Float
  systemSizeKw            Float
  downPayment             Float?
  systemPrice             Float
  riskBand                String
  offersJson              String

  user                    User      @relation(fields: [userId], references:[id], onDelete: Cascade)  
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
}